{
  "manifest_version": 2,
  "name": "Trello Wide Card",
  "version": "1.5.0",
  "description": "Opens Trello card dialogs at 90% of the viewport width.",
  "browser_specific_settings": {
    "gecko": {
      "id": "trello-wide-card@niklas.local",
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://trello.com/*"
      ],
      "css": [
        "trello-wide.css"
      ],
      "run_at": "document_start"
    }
  ]
}
